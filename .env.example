# Ethereum mainnet JSON-RPC URL. Required for contract identification in live mode.
ETHEREUM_RPC_URL=
# Alchemy Transfers API pagination limits; used with ETHEREUM_RPC_URL.
ALCHEMY_MAX_PAGES=10
ALCHEMY_PAGE_SIZE=100
# Approval logs are queried in provider-safe 10-block chunks over this recent window.
RPC_APPROVAL_LOOKBACK_BLOCKS=100
# Optional recent-block fallback collector window.
RPC_LOOKBACK_BLOCKS=20
# Etherscan-compatible API endpoint, for example https://api.etherscan.io/api.
# Required for complete wallet history, ERC-20 transfer, and Approval collection.
ETHERSCAN_API_URL=
# Etherscan V2 chain identifier. Ethereum mainnet is 1.
ETHERSCAN_CHAIN_ID=1
# Etherscan-compatible API key. Never commit this value.
ETHERSCAN_API_KEY=
# Local JSON cache path for explorer responses.
BLOCKNOVA_CACHE_PATH=.blocknova_cache.json
# GoPlus address security endpoint, for example https://api.gopluslabs.io/api/v1/address_security.
# Optional; missing configuration lowers data quality and is reported.
GOPLUS_API_URL=
# Maximum target plus related graph addresses queried for GoPlus signals.
GOPLUS_MAX_ADDRESSES=25
# Optional comma-separated confirmed-risk seed addresses for bounded relationship enrichment.
GOPLUS_SEED_ADDRESSES=
# Optional GoPlus bearer/API credential. Never commit this value.
GOPLUS_API_KEY=
# Reserved for future providers; not required by Phase 2.4.
FORTA_API_KEY=
EXPLORER_API_KEY=
# Optional real EAS deployment settings. Leave empty for local/mock attestation tests.
ATTESTATION_PRIVATE_KEY=
EAS_ADDRESS=
BLOCKNOVA_SCHEMA_UID=
BLOCKNOVA_REGISTRY_ADDRESS=
BLOCKNOVA_TRUSTED_ISSUER=
